# Optional. Copy to .env to use a real LLM for plain-English rules.
# Without LLM_API_KEY the app uses its built-in offline parser (no cost).
# Any OpenAI-compatible provider works. Two with free tiers:
#
# Google Gemini (key from https://aistudio.google.com/apikey)
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   LLM_MODEL=gemini-2.5-flash
#
# Groq (key from https://console.groq.com/keys)
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=openai/gpt-oss-20b

LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-2.5-flash
